# Environment of the control box (sandbox-pool).
#
# Copy the values into the hosting provider's environment settings; secrets
# must never be committed to the repository.

# --- required for a hosted deployment ---------------------------------------
# Public address of the pool. When it is empty the pool takes the address
# from the request headers, which works but makes the OAuth issuer depend on
# the visitor.
POOL_PUBLIC_URL=https://ai-sandbox.example.com

# Bearer token for the pool API. When it is empty the pool generates one and
# stores it in <POOL_STATE_DIR>/pool.token (it is printed in the logs once).
POOL_TOKEN=

# --- storage ---------------------------------------------------------------
# rclone remote that keeps the archives. With WebDAV:
#   [webdav]
#   type = webdav
#   url = https://dav.example.com/remote.php/dav/files/user
#   vendor = other
#   user = user@example.com
#   pass = obscured
ARCHIVE_REMOTE=webdav:ai-sandbox

# The whole rclone config, base64 encoded, so the control box can install it
# in its data volume at startup.
RCLONE_CONF_B64=

# Quota per user for the archives, in bytes (10 GiB).
ARCHIVE_QUOTA_BYTES=10737418240

# --- machines --------------------------------------------------------------
# vibe | ssh | github | local
#   vibe   — the pool creates machines through the Vibe Hosting API
#   ssh    — machines are added by hand, the pool only deploys and leases them
#   github — the pool dispatches a GitHub Actions job that runs the sandbox
#   local  — sandboxes run as processes next to the pool (development)
POOL_PROVIDER=github

# GitHub provider: a token with "Actions: read and write" on the repository
# that holds the sandbox workflow.
GITHUB_TOKEN=
GITHUB_REPO=dustlinux/ai-sandbox
GITHUB_WORKFLOW=sandbox.yml
GITHUB_REF=main
GITHUB_PROFILE=default

# Vibe accounts (only for POOL_PROVIDER=vibe), added through the API:
#   POST /v1/accounts {"api_key":"vibe_…","label":"main"}
VIBE_API=https://thevibehosting.com

# --- notifications ---------------------------------------------------------
# Telegram messages about queueing, archive pruning and failures.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- tuning ----------------------------------------------------------------
HEALTH_INTERVAL=5m
QUEUE_INTERVAL=10s
ACQUIRE_WAIT=180s
POOL_MAX_SERVERS=20
