# syntax=docker/dockerfile:1
# The sandbox image: a small MCP server that an agent drives with shell calls.

FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/sandboxd ./cmd/sandboxd

FROM alpine:3.20
RUN apk add --no-cache ca-certificates bash coreutils tzdata
WORKDIR /app
COPY --from=build /out/sandboxd /app/sandboxd
RUN chmod 0755 /app/sandboxd && mkdir -p /workspace && chmod 700 /workspace

ENV SANDBOX_ROOT=/workspace \
    STATE_FILE=/data/state.json \
    LISTEN=0.0.0.0:8080 \
    IDLE_TIMEOUT=15m \
    MIN_FREE_DISK_MB=128

EXPOSE 8080
ENTRYPOINT ["/app/sandboxd"]
